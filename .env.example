# Django Settings
SECRET_KEY=dev-secret-key-12345
DEBUG=True

# Database Configuration (Defaults to SQLite for local development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOSTNAME=
DB_PORT=

# AWS S3 Settings (Dummy values for local setup, set actual values for S3 storage)
AWS_ACCESS_KEY_ID=dummy-aws-access-key-id
AWS_SECRET_ACCESS_KEY=dummy-aws-secret-access-key
AWS_STORAGE_BUCKET_NAME=dummy-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_REGION=us-east-1

# Signature Secret Key (for webhook/signature verification)
SIGNATURE_SECRET_KEY=dummy-signature-secret-key-xyz

# API Keys & Third Party Services
OPENAI_API_KEY=your-openai-api-key-here
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Twilio Settings
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Stripe Settings
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# AWS Additional Settings
AWS_LAMBDA_SEND_SMS_ARN=dummy-lambda-arn
AWS_SCHEDULER_POLICY_ARN=dummy-scheduler-arn
AWS_LAMBDA_SEND_EMAIL_ARN=dummy-lambda-email-arn
